# MedGuide AI Backend Configuration

# Application Settings
APP_NAME="MedGuide AI Backend"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security Configuration
SECRET_KEY=your-secret-key-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=medguide_ai_dev
DATABASE_URL=postgresql+psycopg://your-db-user:your-db-password@127.0.0.1:5432/medguide_ai_dev

# AI Gateway — M4.3 Grounded RAG (v1.1)
# Provider: ollama (local, primary) | groq (hosted, optional) | mock (testing)
AI_PROVIDER=mock
AI_MODEL=llama3.2:3b

# Ollama (local inference — required when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Groq (optional cloud accelerator — required when AI_PROVIDER=groq)
GROQ_API_KEY=

# RAG Retrieval Parameters (provisional — calibrate with dev benchmark)
RAG_SIMILARITY_THRESHOLD=0.55
RAG_TOP_K_CANDIDATES=10
RAG_TOP_K_CONTEXT=4
CONVERSATION_HISTORY_TURNS=5
MAX_HISTORY_TOKENS=1000
