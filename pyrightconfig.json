{
  "venvPath": "backend",
  "venv": ".venv",
  "pythonPlatform": "Windows",
  "typeCheckingMode": "basic",
  "extraPaths": [
    "backend",
    "backend/app",
    "scripts",
    "backend/.venv/Lib/site-packages"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "app",
        "backend/.venv/Lib/site-packages"
      ]
    },
    {
      "root": "scripts",
      "extraPaths": [
        "scripts",
        "backend",
        "backend/app",
        "backend/.venv/Lib/site-packages"
      ]
    }
  ]
}
